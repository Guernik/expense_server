{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "denarii",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // workers.dev until emilioguernik.com moves to Cloudflare; then:
  // "routes": [{ "pattern": "denarii.emilioguernik.com", "custom_domain": true }]
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "denarii",
      "database_id": "d2a9489e-766b-49e6-babd-de24c5beac48",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Cron Triggers only run in UTC, so the Worker wakes every minute and runs the jobs due in
  // TIMEZONE, e.g. the daily digest at DIGEST_CRON (local time).
  "triggers": { "crons": ["* * * * *"] },
  // Rule packs are bundled as raw text.
  "rules": [{ "type": "Text", "globs": ["**/*.yaml"], "fallthrough": true }],
  // Secrets (wrangler secret put + .prod.vars; the dev bot's in .dev.vars): WEBHOOK_SECRET,
  // TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, TELEGRAM_WEBHOOK_SECRET, and ANTHROPIC_API_KEY with
  // LLM_PROVIDER=anthropic.
  // Optional vars: LLM_PROVIDER (none | anthropic, default none), LLM_MODEL.
  "vars": {
    "RULE_PACKS": "ar.galicia,ar.mercadopago",
    "TIMEZONE": "America/Argentina/Cordoba",
    "LOCALE": "es",
    "DIGEST_CRON": "0 21 * * *"
  }
}
