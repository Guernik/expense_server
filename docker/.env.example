# denarii configuration for docker compose (SPEC §13.1). Copy to .env and fill in.

# MacroDroid sends this in the X-Webhook-Secret header. At least 16 characters.
WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
# The only chat the bot talks to.
TELEGRAM_CHAT_ID=
# polling (default, no public URL needed for the bot) | webhook
TELEGRAM_MODE=polling
# Only with TELEGRAM_MODE=webhook.
# TELEGRAM_WEBHOOK_SECRET=
RULE_PACKS=ar.galicia,ar.mercadopago
TIMEZONE=America/Argentina/Cordoba
# en | es
LOCALE=en
# DIGEST_CRON=0 21 * * *

# Optional LLM (SPEC §11). none | anthropic
LLM_PROVIDER=none
# LLM_MODEL=
# ANTHROPIC_API_KEY=

# Compose settings (not passed to denarii as config).
# Host port for the API. MacroDroid posts to <public URL>/api/ingest.
DENARII_PORT=3000
# Image tag from ghcr.io/guernik/denarii, e.g. 1.2.0. Default: latest.
# DENARII_VERSION=latest
# Token of a Cloudflare Tunnel whose public hostname points to http://denarii:3000.
# Only needed with `--profile tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=
